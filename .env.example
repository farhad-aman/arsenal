# Copy to .env and fill in your values

# ── FortiVPN / OpenConnect ────────────────────────────────────
FORTI_TOTP_SECRET="YOUR_BASE32_TOTP_SECRET"

OC_USER="user@company.com"
OC_PASS="your-password"
OC_SERVER="vpn.company.com:443"
OC_PIN="pin-sha256:YOUR_CERT_PIN"

# ── Pirouz ────────────────────────────────────────────────────
PIROUZ_USER="your.username"
PIROUZ_PASS="your-password"
PIROUZ_SERVER="vpn.example.com:443"

# ── Paths ─────────────────────────────────────────────────────
OVPN_CONFIG="$HOME/.openvpn/your.ovpn"
OVPN_KEYPASS="$HOME/.ovpn_keypass"
SINGBOX_DIR="$HOME/singbox"
FORTI_CONFIG="$HOME/.openfortivpn/config"
