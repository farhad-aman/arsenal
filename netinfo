#!/usr/bin/env bash
# Network info: public IP, geo, interfaces, gateway, DNS, VPN status
# Usage: netinfo [-s|--speed] [-p|--ping]

RUN_SPEED=0
RUN_PING=0
for arg in "$@"; do
  [[ "$arg" == "-s" || "$arg" == "--speed" ]] && RUN_SPEED=1
  [[ "$arg" == "-p" || "$arg" == "--ping"  ]] && RUN_PING=1
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    echo "netinfo — system network info"
    echo ""
    echo "Usage: netinfo [options]"
    echo ""
    echo "Options:"
    echo "  -p, --ping    ping common services (Google, Telegram, GitHub, ...)"
    echo "  -s, --speed   run speedtest after network info"
    echo "  -h, --help    show this help"
    echo ""
    echo "Examples:"
    echo "  netinfo           show public IP, interfaces, gateway, DNS, VPN status"
    echo "  netinfo -p        + HTTP latency check for common services"
    echo "  netinfo -s        + speedtest (Ookla)"
    echo "  netinfo -p -s     + both"
    exit 0
  fi
done

G='\033[0;32m'
Y='\033[1;33m'
C='\033[0;36m'
M='\033[0;35m'
B='\033[1m'
D='\033[2m'
R='\033[0m'

sep()   { echo -e "${D}────────────────────────────────────────${R}"; }
lbl()   { printf "  ${C}%-14s${R}" "$1"; }
badge() { printf " ${D}(%s)${R}" "$1"; }

echo ""
echo -e "${B}  Network${R}"
sep

# ── Public IP + geo ──────────────────────────────────────────
INFO=$(curl -s --max-time 5 "http://ip-api.com/json" 2>/dev/null)
if [[ -n "$INFO" ]]; then
  eval "$(echo "$INFO" | python3 -c "
import json,sys
d=json.load(sys.stdin)
print('PUB_IP=%s'   % repr(d.get('query','?')))
print('CITY=%s'     % repr(d.get('city','?')))
print('REGION=%s'   % repr(d.get('regionName','?')))
print('COUNTRY=%s'  % repr(d.get('country','?')))
print('ORG=%s'      % repr(d.get('isp','?')))
print('TZ=%s'       % repr(d.get('timezone','?')))
print('STATUS=%s'   % repr(d.get('status','fail')))
" 2>/dev/null)"
  if [[ "$STATUS" == "success" ]]; then
    lbl "Public IP";  echo -e "${Y}${PUB_IP}${R}"
    lbl "Location";   echo -e "${CITY}, ${REGION}, ${COUNTRY}"
    lbl "ISP / Org";  echo -e "${D}${ORG}${R}"
    lbl "Timezone";   echo -e "${D}${TZ}${R}"
  else
    lbl "Public IP";  echo -e "${D}(lookup failed — VPN or offline)${R}"
  fi
else
  lbl "Public IP";  echo -e "${D}(timeout — offline or VPN blocking)${R}"
fi

sep

# ── WiFi SSID ────────────────────────────────────────────────
SSID=$(networksetup -getairportnetwork en0 2>/dev/null | sed 's/Current Wi-Fi Network: //')
if [[ "$SSID" != *"not associated"* && -n "$SSID" ]]; then
  lbl "WiFi";  echo -e "${G}${SSID}${R}"
fi

# ── Local interfaces ─────────────────────────────────────────
echo -e "\n${B}  Interfaces${R}"
sep

ifconfig 2>/dev/null | awk '
  /^[a-zA-Z]/ { iface = $1; gsub(/:/, "", iface) }
  /inet / && !/^127\./ && $2 !~ /^127\./ {
    print iface " " $2
  }
' | while read -r iface ip; do
  case "$iface" in
    ppp*)         tag="${M}"; note="FortiVPN (ppp)" ;;
    utun*|tun*)   tag="${M}"; note="VPN tunnel" ;;
    en0)          tag="${G}"; note="WiFi" ;;
    en1)          tag="${G}"; note="Ethernet" ;;
    en*)          tag="${G}"; note="" ;;
    bridge*)      tag="${D}"; note="bridge" ;;
    *)            tag="${C}"; note="" ;;
  esac
  printf "  ${tag}%-10s${R}  ${Y}%-18s${R}" "$iface" "$ip"
  [[ -n "$note" ]] && printf "${D}%s${R}" "$note"
  echo ""
done

sep

# ── Default gateway + latency ────────────────────────────────
GW=$(route -n get default 2>/dev/null | awk '/gateway:/ {print $2}')
if [[ -n "$GW" ]]; then
  RTT=$(ping -c1 -W1 "$GW" 2>/dev/null | awk -F'/' '/round-trip/ {printf "%.1f ms", $5}')
  lbl "Gateway"
  echo -e "${Y}${GW}${R}  ${D}${RTT}${R}"
fi

# ── DNS ──────────────────────────────────────────────────────
DNS=$(scutil --dns 2>/dev/null | awk '/nameserver/ {print $3}' | sort -u | tr '\n' '  ' | sed 's/  $//')
[[ -n "$DNS" ]] && { lbl "DNS"; echo -e "${D}${DNS}${R}"; }

# ── VPN processes ────────────────────────────────────────────
VPNS=()
pgrep -x openfortivpn &>/dev/null && VPNS+=("FortiVPN")
pgrep -x openvpn      &>/dev/null && VPNS+=("OpenVPN")
pgrep -x openconnect  &>/dev/null && VPNS+=("OpenConnect")
pgrep -x sing-box     &>/dev/null && VPNS+=("sing-box")

if [[ ${#VPNS[@]} -gt 0 ]]; then
  lbl "VPN active"
  echo -e "${G}${VPNS[*]}${R}"
else
  lbl "VPN active"
  echo -e "${D}none${R}"
fi

echo ""

# ── Ping checks ──────────────────────────────────────────────
if [[ $RUN_PING -eq 1 ]]; then
  echo -e "${B}  Ping${R}"
  sep

  declare -A PING_HOSTS=(
    ["Google"]="google.com"
    ["YouTube"]="youtube.com"
    ["Telegram"]="telegram.org"
    ["GitHub"]="github.com"
    ["Cloudflare"]="1.1.1.1"
    ["X / Twitter"]="x.com"
    ["OpenAI"]="openai.com"
    ["Claude"]="claude.ai"
    ["PSN"]="playstation.com"
    ["Homebrew"]="brew.sh"
  )

  declare -A PING_ORDER=(
    [0]="Google" [1]="YouTube" [2]="Telegram" [3]="GitHub"
    [4]="Cloudflare" [5]="X / Twitter" [6]="OpenAI" [7]="Claude" [8]="PSN" [9]="Homebrew"
  )

  ping_host() {
    local name=$1 host=$2
    local rtt
    rtt=$(curl -s -o /dev/null -w "%{time_total}" --max-time 10 "https://${host}" 2>/dev/null)
    rtt=$(python3 -c "print(int(float('${rtt:-0}') * 1000))" 2>/dev/null)
    printf "  ${C}%-14s${R}" "$name"
    if [[ -z "$rtt" || "$rtt" == "0" ]]; then
      echo -e "${D}timeout${R}"
    elif (( rtt < 150 )); then
      echo -e "${G}${rtt} ms${R}"
    elif (( rtt < 400 )); then
      echo -e "${Y}${rtt} ms${R}"
    else
      echo -e "\033[0;31m${rtt} ms${R}"
    fi
  }

  PTMP=$(mktemp -d)
  for i in "${!PING_ORDER[@]}"; do
    name="${PING_ORDER[$i]}"
    ( ping_host "$name" "${PING_HOSTS[$name]}" > "${PTMP}/${i}" ) &
  done
  wait
  for i in $(seq 0 $(( ${#PING_ORDER[@]} - 1 ))); do
    [[ -f "${PTMP}/${i}" ]] && cat "${PTMP}/${i}"
  done
  rm -rf "$PTMP"
  echo ""
fi

# ── Speed test ───────────────────────────────────────────────
if [[ $RUN_SPEED -eq 1 ]]; then
  echo -e "${B}  Speed Test${R}"
  sep
  speedtest --progress=yes
  echo ""
fi
